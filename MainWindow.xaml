<Window x:Class="Práctica1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Práctica1"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Window.Resources>
        <Style x:Key="FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" StrokeDashArray="1 2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD"/>
        <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070"/>
        <SolidColorBrush x:Key="Button.MouseOver.Background" />
        <SolidColorBrush x:Key="Button.MouseOver.Border" />
        <SolidColorBrush x:Key="Button.Pressed.Background" />
        <SolidColorBrush x:Key="Button.Pressed.Border" />
        <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4"/>
        <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5"/>
        <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383"/>
        <Style x:Key="BotónLateral" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Background" Value="{StaticResource Button.Static.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.MouseOver.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.MouseOver.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Pressed.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Pressed.Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="GridPrincipal">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="EstadosLogin">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00.2500000" To="EstadoLogin"/>
                    <VisualTransition GeneratedDuration="00:00:00.2500000" To="EstadoSignUp"/>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="EstadoLogin"/>
                <VisualState x:Name="EstadoSignUp">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Tab" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="165"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Inicio" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,2,2,2" VerticalAlignment="Top">
                    <Image Source="/img/inicio.png" Stretch="UniformToFill" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                </Grid>

                <Grid Grid.Column="1" Background="White" Margin="2">
                    <StackPanel VerticalAlignment="Center" Margin="30,0,30,0">
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap"><Run Text="NUEVO MAZDA "/><Run Language="es-es" Text="M"/><Run Text="X-5"/></TextBlock>
                        <TextBlock Text="DESDE 29.995€" FontSize="18" Foreground="#444444" Margin="0,10,0,20"/>
                        <Button Content="DESCÚBRELO" Height="42" Width="140" Background="#FF041428" Foreground="White" FontWeight="Bold" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand" Click="AbrirMX5"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="#222222" Margin="0,2,2,0">
                    <Image Source="/img/lente.jfif" Stretch="UniformToFill" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Column="1" Margin="2,2,0,0">
                    <Image Source="/img/llave.jpg" Stretch="UniformToFill" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="Login" Grid.Row="1" Visibility="Collapsed">
            <Grid>
                <Image Source="/img/fondo_login2.png" Stretch="UniformToFill"/>
            </Grid>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="400" Margin="0,0,80,0" Background="White" CornerRadius="8" Padding="35,25,35,30">
                <StackPanel>

                    <Image x:Name="LogoLogin" Height="31" Source="/img/logo_login.png" Stretch="Uniform" Width="38" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{DynamicResource BotónLateral}" x:Name="BtnTabLogin" Grid.Row="0" Grid.Column="0" Content="LOGIN" FontWeight="Bold" FontSize="14" Foreground="#111111" Background="{x:Null}" BorderBrush="{x:Null}" Click="BtnTabLoginClick" Cursor="Hand"/>
                        <Button Style="{DynamicResource BotónLateral}" x:Name="BtnTabSignUp" Grid.Row="0" Grid.Column="1" Content="SIGN UP" FontWeight="Normal" FontSize="14" Foreground="#888888" Background="{x:Null}" BorderBrush="{x:Null}" Click="BtnTabSignUpClick" Cursor="Hand"/>
                        <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="1" Fill="#CCCCCC" Margin="0,8,0,0"/>
                        <Rectangle x:Name="Tab" Grid.Row="1" Grid.Column="0" Height="3" Fill="#FF041428" Margin="0,7,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>

                    <Border CornerRadius="18" BorderBrush="#CCCCCC" BorderThickness="1" Height="44" Margin="0,0,0,15" Background="White">
                        <TextBox x:Name="txtUsuario" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="15,0,15,0" Foreground="#333333" FontSize="14" Text="Email"/>
                    </Border>

                    <Border CornerRadius="18" BorderBrush="#CCCCCC" BorderThickness="1" Height="44" Margin="0,0,0,25" Background="White">
                        <Grid>
                            <TextBlock x:Name="PlaceholderPassword" Text="Contraseña" VerticalAlignment="Center" Padding="15,0,15,0" Foreground="#888888" FontSize="14" IsHitTestVisible="False"/>
                            <PasswordBox x:Name="txtPassword" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="15,0,15,0" Foreground="#333333" FontSize="14" PasswordChanged="txtPassword_PasswordChanged"/>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnInicioSesion" Content="INICIAR SESIÓN" Height="44" Background="#FF041428" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,20" Click="ComprobarLogin" Cursor="Hand"/>

                    <Button Style="{DynamicResource BotónLateral}" HorizontalAlignment="Center" Cursor="Hand" Click="OlvidasteContrasena" Background="{x:Null}" BorderBrush="{x:Null}">
                        <TextBlock Text="¿Olvidaste tu contraseña?" FontSize="11" FontWeight="Bold" Foreground="#444444" TextDecorations="Underline"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="Galería" Grid.Row="1" Background="#F8F9FA" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,30,40,30">

                    <TextBlock Text="DESCUBRE NUESTRA GAMA" FontSize="24" FontWeight="Bold" Foreground="#FF041428" Margin="0,0,0,4"/>
                    <TextBlock Text="Encuentra el Mazda que mejor se adapta a ti." FontSize="14" Foreground="#666666" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="10" Margin="0,0,10,20" Padding="20">
                            <StackPanel>
                                <Image Source="/img/mx-5.jfif" Height="150" Stretch="Uniform" Margin="0,0,0,15"/>
                                <TextBlock Text="MAZDA MX-5" FontSize="18" FontWeight="Bold" Foreground="#111111"/>
                                <TextBlock Text="Deportivo · Descapotable" FontSize="13" Foreground="#777777" Margin="0,4,0,15"/>
                                <Button Style="{DynamicResource BotónLateral}" HorizontalAlignment="Left" Background="{x:Null}" BorderBrush="{x:Null}" Cursor="Hand" Click="AbrirMX5">
                                    <TextBlock Text="DESCUBRIR MODELO ❯" FontSize="12" FontWeight="Bold" Foreground="#FF041428"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="10" Margin="5,0,5,20" Padding="20">
                            <StackPanel>
                                <Image Source="/img/cx-5.jpg" Height="150" Stretch="Uniform" Margin="0,0,0,15"/>
                                <TextBlock Text="MAZDA CX-5" FontSize="18" FontWeight="Bold" Foreground="#111111"/>
                                <TextBlock Text="SUV · Familiar" FontSize="13" Foreground="#777777" Margin="0,4,0,15"/>
                                <TextBlock Text="DESCUBRIR MODELO ❯" FontSize="12" FontWeight="Bold" Foreground="#FF041428" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Background="White" CornerRadius="10" Margin="10,0,0,20" Padding="20">
                            <StackPanel>
                                <Image Source="/img/mazda6.jfif" Height="150" Stretch="Uniform" Margin="0,0,0,15"/>
                                <TextBlock Text="MAZDA6" FontSize="18" FontWeight="Bold" Foreground="#111111"/>
                                <TextBlock Text="Berlina · Premium" FontSize="13" Foreground="#777777" Margin="0,4,0,15"/>
                                <TextBlock Text="DESCUBRIR MODELO ❯" FontSize="12" FontWeight="Bold" Foreground="#FF041428" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="10" Margin="0,0,10,0" Padding="20">
                            <StackPanel>
                                <Image Source="/img/mazda3.jfif" Height="150" Stretch="Uniform" Margin="0,0,0,15"/>
                                <TextBlock Text="MAZDA3" FontSize="18" FontWeight="Bold" Foreground="#111111"/>
                                <TextBlock Text="Compacto · 5 puertas" FontSize="13" Foreground="#777777" Margin="0,4,0,15"/>
                                <TextBlock Text="DESCUBRIR MODELO ❯" FontSize="12" FontWeight="Bold" Foreground="#FF041428" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="10" Margin="5,0,5,0" Padding="20">
                            <StackPanel>
                                <Image Source="/img/cx-30.jfif" Height="150" Stretch="Uniform" Margin="0,0,0,15"/>
                                <TextBlock Text="MAZDA CX-30" FontSize="18" FontWeight="Bold" Foreground="#111111"/>
                                <TextBlock Text="SUV · Compacto" FontSize="13" Foreground="#777777" Margin="0,4,0,15"/>
                                <TextBlock Text="DESCUBRIR MODELO ❯" FontSize="12" FontWeight="Bold" Foreground="#FF041428" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Background="White" CornerRadius="10" Margin="10,0,0,0" Padding="20">
                            <StackPanel>
                                <Image Source="/img/cx-60.jfif" Height="150" Stretch="Uniform" Margin="0,0,0,15"/>
                                <TextBlock Text="MAZDA CX-60" FontSize="18" FontWeight="Bold" Foreground="#111111"/>
                                <TextBlock Text="SUV · Híbrido Enchufable" FontSize="13" Foreground="#777777" Margin="0,4,0,15"/>
                                <TextBlock Text="DESCUBRIR MODELO ❯" FontSize="12" FontWeight="Bold" Foreground="#FF041428" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="MX5" Grid.Row="1" Background="#F8F9FA" Visibility="Collapsed">
            <Grid Margin="50,35,50,35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="10" Margin="0,0,15,0" Padding="30">
                    <Grid>
                        <Button Style="{DynamicResource BotónLateral}" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{x:Null}" BorderBrush="{x:Null}" Cursor="Hand" Click="AbrirGalería">
                            <TextBlock Text="❮ VOLVER A LA GAMA" FontSize="12" FontWeight="Bold" Foreground="#666666"/>
                        </Button>
                        <Image Source="/img/mx-5.jfif" Stretch="Uniform" MaxHeight="320" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="10" Margin="15,0,0,0" Padding="40">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DEPORTIVO · DESCAPOTABLE" FontSize="12" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                        <TextBlock Text="MAZDA MX-5" FontSize="30" FontWeight="Bold" Foreground="#FF041428"/>
                        <TextBlock Text="Desde 29.995€" FontSize="20" Foreground="#444444" Margin="0,6,0,20"/>

                        <TextBlock Text="El roadster más icónico del mundo. Diseño Kodo, tracción trasera y una distribución de pesos perfecta 50:50 para sentir cada curva." FontSize="14" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,25"/>

                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="POTENCIA" FontSize="11" FontWeight="Bold" Foreground="#888888"/>
                                <TextBlock Text="184 CV" FontSize="18" FontWeight="Bold" Foreground="#111111" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="0 - 100 KM/H" FontSize="11" FontWeight="Bold" Foreground="#888888"/>
                                <TextBlock Text="6,5 s" FontSize="18" FontWeight="Bold" Foreground="#111111" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TRACCIÓN" FontSize="11" FontWeight="Bold" Foreground="#888888"/>
                                <TextBlock Text="Trasera" FontSize="18" FontWeight="Bold" Foreground="#111111" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="SOLICITAR PRUEBA" Height="44" Width="190" Background="#FF041428" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand" Click="SolicitarPrueba"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="BarraHorizontal" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="80" Background="#FF041428">
            <Button Style="{DynamicResource BotónLateral}" x:Name="BtnAbrirLateral" Content="☰" HorizontalAlignment="Right" Height="60" Margin="0,0,20,0" VerticalAlignment="Center" Width="76" FontSize="36" Foreground="White" Background="{x:Null}" BorderBrush="{x:Null}" Click="AbrirLateral" Cursor="Hand"/>
            <Image Source="/img/logo_letra.png" HorizontalAlignment="Left" VerticalAlignment="Center" Height="70" Margin="30,0,0,0" Stretch="Uniform" Width="70"/>
        </Grid>

        <Border x:Name="MenuLateral" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" Width="240" Background="#FF041428" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="TransfMenu" X="280"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="Black" Direction="180" ShadowDepth="6" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Button Style="{DynamicResource BotónLateral}" x:Name="BtnCerrarLateral" Content="✕" HorizontalAlignment="Right" Height="60" Margin="0,10,20,0" VerticalAlignment="Top" Width="76" FontSize="36" Foreground="White" Background="{x:Null}" BorderBrush="{x:Null}" Click="CerrarLateral" Cursor="Hand"/>

                <StackPanel Margin="20,100,20,0">
                    <Button Style="{DynamicResource BotónLateral}" x:Name="BtnInicio" Content="INICIO" Height="64" Margin="0,10,0,10" FontSize="22" FontWeight="Bold" Foreground="White" Background="{x:Null}" BorderBrush="{x:Null}" Click="AbrirInicio" Cursor="Hand"/>
                    <Button Style="{DynamicResource BotónLateral}" x:Name="BtnLogin" Content="LOGIN" Height="64" Margin="0,10,0,10" FontSize="22" FontWeight="Bold" Foreground="White" Background="{x:Null}" BorderBrush="{x:Null}" Click="AbrirLogin" Cursor="Hand"/>
                    <Button Style="{DynamicResource BotónLateral}" x:Name="BtnGalería" Content="GALERÍA" Height="64" Margin="0,10,0,10" FontSize="22" FontWeight="Bold" Foreground="White" Background="{x:Null}" BorderBrush="{x:Null}" Click="AbrirGalería" Cursor="Hand"/>
                </StackPanel>
                <Button Style="{DynamicResource BotónLateral}" x:Name="BtnSalir" Content="SALIR" Height="50" Margin="20,0,20,20" VerticalAlignment="Bottom" FontSize="20" FontWeight="Bold" Foreground="#FFCC3333" Background="{x:Null}" BorderBrush="{x:Null}" Click="BotonSalir" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>